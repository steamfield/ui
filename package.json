      "default": "./dist/vue/agent-demo/index.js"
    },
    "./window/styles.css": "./dist/window/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json && tsc -p playground/tsconfig.json",
    "lint": "biome check .",
    "lint:package": "bun scripts/lint-package.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "bun scripts/consumer.ts",
    "coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run coverage && bun run build && bun run lint:package && bun run test:consumer && bun run size && bun run test:tree-shake",
    "clean": "rm -rf dist coverage *.tgz",
    "prepack": "bun run build",
    "prepare": "bun scripts/prepare.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "test:a11y": "playwright test",
    "size": "size-limit",
    "test:tree-shake": "bun scripts/tree-shake.ts"
  },
  "peerDependencies": {
    "@types/react": "^19.2",
    "github-slugger": "^2.0.0",
    "react": "^19.2",
    "react-dom": "^19.2",
