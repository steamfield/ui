    "./reveal/styles.css": "./dist/reveal/styles.css",
    "./script": {
      "types": "./dist/script/index.d.ts",
      "default": "./dist/script/index.js"
    },
    "./sequencer": {
      "types": "./dist/sequencer/index.d.ts",
      "default": "./dist/sequencer/index.js"
