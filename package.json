{
  "name": "@steamfield/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Tree-shakeable demo, copy, tabs and reveal components shared across the Steamfield landing and docs sites.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "biome check .",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "bun scripts/consumer.ts",
    "coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run coverage && bun run lint:package && bun run test:consumer",
    "clean": "rm -rf dist coverage *.tgz",
    "prepack": "bun run build",
    "prepare": "bun scripts/prepare.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.2"
}
