// Library boundaries: src/ runs on any runtime, reads nothing from the process, never logs, throws
// only LibraryError, and its entries (src/**/index.ts) export by name and never from src/internal/.
language js

or {
  or {
    JsModuleSource() as $src,
    `import($src)`
  } where {
    $filename <: r".*/src/.*",
    $src <: r"[\"'`](?:node:[^\"'`]+|bun|bun:[^\"'`]*)[\"'`]",
    register_diagnostic(span=$src, message="src/ is platform neutral: it runs in Node, Bun, Deno and browsers. Take what you need as a parameter instead of importing a runtime module.")
  },
  JsModuleSource() as $src where {
    $filename <: r".*/src/(?:.*/)?index\.tsx?",
    $src <: r"[\"'](?:\./|(?:\.\./)+)internal/.*[\"']",
    register_diagnostic(span=$src, message="src/internal/ is private. Export a public module from a subpath entry (src/<subpath>/index.ts), not an internal one.")
  },
  or {
    `process.$x`,
    `globalThis.process`
  } as $p where {
    $filename <: r".*/src/.*",
    register_diagnostic(span=$p, message="A library never reads the process (env, argv, exit). Take it as an option from the caller.")
  },
  or {
    JsReferenceIdentifier() as $ref where { $ref <: "console" },
    `globalThis.console`,
    `window.console`,
    `self.console`
  } as $c where {
    $filename <: r".*/src/.*",
    $filename <: not r".*\.test\.tsx?",
    register_diagnostic(span=$c, message="A library never writes to the console. Return the value, or throw LibraryError with a code.")
  },
  // Building any built-in error, with or without `new`, covers throw, Promise.reject and return.
  or {
    `new $cls($args)`,
    `$cls($args)`
  } as $t where {
    $cls <: r"(?:(?:globalThis|window|self)\.)?(?:(?:[A-Z][A-Za-z]*)?Error|DOMException)",
    $cls <: not "LibraryError",
    $filename <: r".*/src/.*",
    $filename <: not r".*\.test\.tsx?",
    register_diagnostic(span=$t, message="Throw or reject only with LibraryError and one of its codes (defined in src/internal/errors.ts, public from src/script/errors.ts), so callers can branch on error.code.")
  },
  or {
    JsExportDefaultDeclarationClause(),
    JsExportDefaultExpressionClause(),
    `export * from $src`,
    `export * as $ns from $src`
  } as $e where {
    $filename <: r".*/src/.*",
    register_diagnostic(span=$e, message="Export by name, so each subpath's public API is the list in its index.ts and the build can drop unused code.")
  }
}
